meta {
  name: Search addresses
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/addresses/searches
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "radius": 10,
    "from": { "lat": 48.85, "lng": 2.35 }
  }
}

tests {
  test("returns close addresses", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.items).to.be.an("array");
  });
}
