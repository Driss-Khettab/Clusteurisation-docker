meta {
  name: Sign in
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/users/tokens
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
}

tests {
  test("returns a token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.token).to.be.a("string");
  });
}
